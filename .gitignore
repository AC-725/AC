# Firecrawl CLI scratch output (scrape/crawl results)
.firecrawl/

# Never commit credentials. EXA_API_KEY / FIRECRAWL_API_KEY belong in the
# environment's variable settings, not in the repo.
.env
.env.*
!.env.example

# Python bytecode from skill scripts
__pycache__/
*.pyc

# Packaged .skill bundles — build artifacts, regenerate with system/scripts/reapply_handle.py
dist-skills/
