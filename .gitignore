# Firecrawl CLI scratch output (scrape/crawl results)
.firecrawl/

# Never commit credentials. EXA_API_KEY / FIRECRAWL_API_KEY belong in the
# environment's variable settings, not in the repo.
.env
.env.*
!.env.example
ac-studio.skill

# Render intermediates — regenerated by produce.sh on every build.
runs/**/master_*.wav
runs/**/frames/
# Gate 7 keeps the contact sheet; the 31 source tiles are scratch.
runs/**/_filmstrip/q_*.png

# Delivery bundles — regenerated by scripts/package_run.sh from files already here.
runs/**/*.zip
